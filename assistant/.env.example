# 复制本文件为 .env,并填入你的 Key(.env 不会被提交到 Git)
ANTHROPIC_API_KEY=在这里填你的Key

# 可选:“星期五”对你的称呼(只在 friday.bat / --persona friday 时使用)
# FRIDAY_CALL_ME=老板

# 可选:“星期五”记忆文件的位置(默认是 assistant/friday_memory.json)
# FRIDAY_MEMORY_FILE=D:\我的资料\friday_memory.json

# 可选:语音识别引擎。google 在线(默认,需要能访问 Google);vosk 离线(首次自动下载约 42MB 中文模型)
# FRIDAY_STT=vosk

# 可选:朗读的声音。edge 微软在线神经网络语音(默认,更自然,需要联网);system 系统自带语音(离线)
# FRIDAY_TTS=edge
# 可选:在线语音选哪个声音:xiaoxiao(默认,女声)、xiaoyi(女声,活泼)、yunxi(男声,阳光)、yunjian(男声,沉稳)、yunyang(男声,播音)
# FRIDAY_TTS_VOICE=xiaoxiao

# 可选:语音模式下停顿几秒算一句话说完(默认 2 秒)。说话时常停下来想的话可以调大,比如 3
# FRIDAY_PAUSE=2

# 可选:语音模式下在后台播放听不见的极小声音,防止扬声器/蓝牙耳机休眠导致每句话开头被吞掉。设为 0 关闭
# FRIDAY_KEEP_AUDIO_AWAKE=1

# 可选:Discord 机器人的 Token(用 discord-setup.bat 设置,会自动写到这里)
# FRIDAY_DISCORD_TOKEN=
