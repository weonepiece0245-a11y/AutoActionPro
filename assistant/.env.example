# 复制本文件为 .env,并填入你的 Key(.env 不会被提交到 Git)
ANTHROPIC_API_KEY=在这里填你的Key

# 可选:“星期五”对你的称呼(只在 friday.bat / --persona friday 时使用)
# FRIDAY_CALL_ME=老板

# 可选:“星期五”记忆文件的位置(默认是 assistant/friday_memory.json)
# FRIDAY_MEMORY_FILE=D:\我的资料\friday_memory.json

# 可选:语音识别引擎。google 在线(默认,需要能访问 Google);vosk 离线(首次自动下载约 42MB 中文模型)
# FRIDAY_STT=vosk
